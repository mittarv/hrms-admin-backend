<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Invitation to EXTIndiax Admin Panel</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 40px 20px;
        }
        .container {
            max-width: 560px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            border: 1px solid #f1f5f9;
        }
        .header {
            text-align: center;
            padding: 30px 20px;
            background-color: #ffffff;
            border-bottom: 1px solid #f1f5f9;
        }
        .header img {
            height: 40px;
            margin-bottom: 15px;
        }
        .header h1 {
            color: #0f172a;
            font-size: 24px;
            margin: 0;
            font-weight: 600;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 30px 40px;
            color: #475569;
            line-height: 1.6;
            font-size: 15px;
        }
        .greeting {
            color: #1e293b;
            font-size: 18px;
            font-weight: 600;
            margin-top: 0;
            margin-bottom: 20px;
        }
        .access-card {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
        }
        .access-card-title {
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 12px;
            margin-top: 0;
        }
        .access-row {
            display: flex;
            align-items: flex-start;
            margin-bottom: 10px;
        }
        .access-row:last-child {
            margin-bottom: 0;
        }
        .access-label {
            font-weight: 500;
            color: #334155;
            width: 130px;
            flex-shrink: 0;
        }
        .access-value {
            color: #0f172a;
            font-weight: 600;
        }
        .org-list {
            margin: 0;
            padding-left: 18px;
            color: #0f172a;
        }
        .org-list li {
            margin-bottom: 4px;
        }
        .org-list li:last-child {
            margin-bottom: 0;
        }
        .btn-container {
            text-align: center;
            margin-top: 35px;
            margin-bottom: 35px;
        }
        .btn {
            /* Fallback for clients that support class styles */
            background-color: #2563eb !important;
            color: #ffffff !important;
            padding: 14px 32px;
            text-decoration: none !important;
            border-radius: 8px;
            font-weight: 600;
            font-size: 16px;
            display: inline-block;
            line-height: 1.25;
            mso-padding-alt: 0;
        }
        .fallback {
            font-size: 13px;
            color: #64748b;
            text-align: center;
        }
        .fallback a {
            color: #2563eb;
            word-break: break-all;
        }
        .footer {
            text-align: center;
            font-size: 13px;
            color: #94a3b8;
            padding: 20px;
            background-color: #f8fafc;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Welcome to EXTIndia Admin Panel</h1>
        </div>
        <div class="content">
            <p class="greeting">Hi {{name}},</p>
            <p>You have been invited to join the EXTIndia Admin Panel. An administrator has granted you access to manage the platform.</p>
            
            <div class="access-card">
                <p class="access-card-title">Your Access Details</p>
                <div class="access-row">
                    <div class="access-label">Role:</div>
                    <div class="access-value" style="color: #2563eb;">{{role}}</div>
                </div>
                <div class="access-row">
                    <div class="access-label">Organizations:</div>
                    <div class="access-value">
                        {{#if organizations.length}}
                            <ul class="org-list">
                                {{#each organizations}}
                                    <li>{{this}}</li>
                                {{/each}}
                            </ul>
                        {{else}}
                            Global Access
                        {{/if}}
                    </div>
                </div>
            </div>

            <p>To accept your invitation and securely log in with your Google Workspace account, please click the button below:</p>
            
            <!-- Bulletproof email button (table + inline styles for Gmail/Outlook) -->
            <div class="btn-container">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: 0 auto;">
                <tr>
                  <td align="center" bgcolor="#2563eb" style="border-radius: 8px; background-color: #2563eb;">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{inviteLink}}" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="17%" stroke="f" fillcolor="#2563eb">
                      <w:anchorlock/>
                      <center style="color:#ffffff;font-family:Segoe UI, Arial, sans-serif;font-size:16px;font-weight:600;">Accept Invitation</center>
                    </v:roundrect>
                    <![endif]-->
                    <!--[if !mso]><!-- -->
                    <a href="{{inviteLink}}" class="btn" target="_blank" rel="noopener noreferrer"
                       style="display: inline-block; background-color: #2563eb; color: #ffffff !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 600; line-height: 1.25; text-align: center; text-decoration: none !important; padding: 14px 32px; border-radius: 8px; mso-padding-alt: 0;">
                      Accept Invitation
                    </a>
                    <!--<![endif]-->
                  </td>
                </tr>
              </table>
            </div>
            
            <div class="fallback">
                <p>If the button doesn't work, copy and paste this link into your browser:</p>
                <p><a href="{{inviteLink}}" target="_blank" rel="noopener noreferrer" style="color: #2563eb; word-break: break-all;">{{inviteLink}}</a></p>
                <p style="margin-top: 20px;">If you didn't expect this invitation, you can safely ignore this email.</p>
            </div>
        </div>
        <div class="footer">
            &copy; {{year}} EXTIndia. All rights reserved.
        </div>
    </div>
</body>
</html>
