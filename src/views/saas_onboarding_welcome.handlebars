<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome to EXT India HRMS</title>
<!--[if mso]>
<noscript>
<xml>
<o:OfficeDocumentSettings>
<o:PixelsPerInch>96</o:PixelsPerInch>
</o:OfficeDocumentSettings>
</xml>
</noscript>
<![endif]-->
<style>
  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
  body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; background-color: #eef0f4; }
  a { color: #1f3a5f; }

  @media screen and (max-width: 600px) {
    .email-container { width: 100% !important; }
    .fluid-padding { padding-left: 24px !important; padding-right: 24px !important; }
  }
</style>
</head>

<body style="margin:0; padding:0; background-color:#eef0f4;">

<!-- Preheader (hidden preview text) -->
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
  Your EXT India HRMS workspace is ready. Sign in to get started.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef0f4;">
<tr>
<td align="center" style="padding:40px 16px;">

<table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background-color:#ffffff; border:1px solid #e2e5eb; border-radius:6px; overflow:hidden;">

  <!-- Header -->
  <tr>
    <td class="fluid-padding" style="background-color:#1f3a5f; padding:32px 40px; text-align:left;">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="background-color:#EDE9FE; border-radius:6px; padding:4px 12px 4px 12px;">
            <span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#5B43D6; letter-spacing:0.01em;">EXT</span>
          </td>
          <td style="padding:6px 0 6px 8px;">
            <span style="font-family:Arial, Helvetica, sans-serif; font-size:20px; font-weight:bold; color:#ffffff; letter-spacing:0.01em;">India</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Title bar -->
  <tr>
    <td class="fluid-padding" style="padding:36px 40px 8px 40px;">
      <p style="margin:0 0 6px 0; font-family:Arial, Helvetica, sans-serif; font-size:13px; letter-spacing:0.06em; text-transform:uppercase; color:#8a93a3; font-weight:bold;">
        Workspace ready
      </p>
      <h1 style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:22px; line-height:30px; color:#1a1a1a; font-weight:bold;">
        Welcome to EXT India HRMS
      </h1>
    </td>
  </tr>

  <!-- Body -->
  <tr>
    <td class="fluid-padding" style="padding:16px 40px 8px 40px; font-family:Arial, Helvetica, sans-serif;">
      <p style="margin:0 0 16px 0; font-size:15px; line-height:24px; color:#3d3d3d;">
        Hello {{adminName}},
      </p>
      <p style="margin:0 0 16px 0; font-size:15px; line-height:24px; color:#3d3d3d;">
        Your organisation, <strong>{{organizationName}}</strong>, has been successfully onboarded to EXT India HRMS. You have been assigned the <strong>Super Administrator</strong> role, with full access to manage employees, departments, attendance, payroll, and leave.
      </p>
    </td>
  </tr>

  <!-- Details card -->
  <tr>
    <td class="fluid-padding" style="padding:16px 40px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f7fa; border:1px solid #e2e5eb; border-radius:6px;">
        <tr>
          <td style="padding:20px 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#3d3d3d;">
              <tr>
                <td style="padding:6px 0; color:#8a93a3; width:130px;">Role</td>
                <td style="padding:6px 0; font-weight:bold;">Super Administrator</td>
              </tr>
              <tr>
                <td style="padding:6px 0; color:#8a93a3;">Login email</td>
                <td style="padding:6px 0; font-weight:bold;">{{email}}</td>
              </tr>
              <tr>
                <td style="padding:6px 0; color:#8a93a3;">Workspace</td>
                <td style="padding:6px 0; font-weight:bold;">{{organizationName}}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- CTA -->
  <tr>
    <td class="fluid-padding" style="padding:28px 40px 8px 40px;" align="left">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="border-radius:5px; background-color:#1f3a5f;">
            <a href="{{redirectUrl}}" target="_blank" style="display:inline-block; padding:13px 30px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:5px;">
              Sign in to HRMS
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Fallback link -->
  <tr>
    <td class="fluid-padding" style="padding:20px 40px 8px 40px; font-family:Arial, Helvetica, sans-serif;">
      <p style="margin:0 0 8px 0; font-size:13px; line-height:20px; color:#8a93a3;">
        If the button doesn't work, copy and paste this link into your browser:
      </p>
      <p style="margin:0; font-size:13px; line-height:20px; color:#1f3a5f; word-break:break-all;">
        {{redirectUrl}}
      </p>
    </td>
  </tr>

  <!-- Security note -->
  <tr>
    <td class="fluid-padding" style="padding:24px 40px 40px 40px; font-family:Arial, Helvetica, sans-serif;">
      <p style="margin:0 0 14px 0; font-size:13px; line-height:22px; color:#8a93a3;">
        For security, sign in using the same email address that received this invitation, so your administrator access is applied automatically.
      </p>
      <p style="margin:0; font-size:14px; line-height:22px; color:#3d3d3d;">
        Regards,<br>
        <strong>Team EXT India</strong>
      </p>
    </td>
  </tr>

  <!-- Footer -->
  <tr>
    <td style="background-color:#f6f7fa; border-top:1px solid #e2e5eb; padding:24px 40px; font-family:Arial, Helvetica, sans-serif;" align="center">
      <p style="margin:0 0 6px 0; font-size:12px; line-height:18px; color:#9aa0ab;">
        © {{year}} EXT India Technologies Pvt. Ltd. All rights reserved.
      </p>
      <p style="margin:0; font-size:12px; line-height:18px; color:#9aa0ab;">
        <a href="https://extindia.com" style="color:#9aa0ab; text-decoration:underline;">www.extindia.com</a>
      </p>
    </td>
  </tr>

</table>

</td>
</tr>
</table>

</body>
</html>